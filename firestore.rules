rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null
        && request.auth.token.email in ["remziazakli@gmail.com","rmzazakli@gmail.com","sudenzturk@gmail.com"]
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function ownId(id) {
      return request.auth != null && id in [request.auth.uid + '_ai', request.auth.uid + '_ew', request.auth.uid + '_uav', request.auth.uid + '_other'];
    }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }
    function valid(d, id) {
      return d.keys().hasAll(['uid','category','fullName','phone','email','customArea','university','department','year','portfolio','skills','experience','time','motivation','project','consent','consentVersion','createdAt','status','emailNotified'])
        && d.keys().hasOnly(['uid','category','fullName','phone','email','customArea','university','department','year','portfolio','skills','experience','time','motivation','project','consent','consentVersion','createdAt','status','emailNotified'])
        && d.uid == request.auth.uid && d.category in ['ai','ew','uav','other']
        && id == request.auth.uid + '_' + d.category
        && text(d.fullName, 2, 100) && text(d.phone, 10, 20) && d.phone.matches('^\\+?[0-9 ()-]{10,20}$') && text(d.email, 3, 150)
        && d.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$')
        && text(d.customArea, 0, 100) && ((d.category == 'other' && text(d.customArea, 2, 100)) || d.customArea == '')
        && text(d.university, 2, 150) && text(d.department, 2, 150)
        && d.year in ['Hazırlık','1. sınıf','2. sınıf','3. sınıf','4. sınıf ve üzeri','Lisansüstü']
        && text(d.portfolio, 0, 250) && (d.portfolio == '' || d.portfolio.matches('^https?://[^\\s]+$'))
        && d.skills is list && d.skills.size() <= 6
        && ((d.category == 'ai' && d.skills.hasOnly(['Python','OpenCV','Derin öğrenme','Veri hazırlama','C++','Yeni başlıyorum']))
          || (d.category == 'ew' && d.skills.hasOnly(['RF / anten','Sinyal işleme','Elektronik tasarım','Gömülü sistemler','Python / MATLAB','Yeni başlıyorum']))
          || (d.category == 'uav' && d.skills.hasOnly(['Mekanik / CAD','Aviyonik','Uçuş yazılımı','Görüntü işleme','Üretim / kompozit','Yeni başlıyorum']))
          || (d.category == 'other' && d.skills.hasOnly(['Fikir geliştirme','Tasarım','Organizasyon','İletişim','İş geliştirme','Yeni başlıyorum'])))
        && d.experience in ['Yeni başlıyorum, öğrenmek istiyorum','Temel bilgim var','Kişisel / ders projesi geliştirdim','Takım / yarışma deneyimim var']
        && d.time in ['3–5 saat','6–10 saat','11–15 saat','16 saat ve üzeri']
        && text(d.motivation, 20, 1200) && text(d.project, 0, 1500)
        && d.consent == true && d.consentVersion == '2026-09-20'
        && d.createdAt == request.time && d.status == 'new' && d.emailNotified == false;
    }
    match /settings/registration {
      allow get: if true;
      allow create, update: if admin() && request.resource.data.keys().hasAll(['enabled','updatedAt'])
        && request.resource.data.keys().hasOnly(['enabled','updatedAt'])
        && request.resource.data.enabled is bool && request.resource.data.updatedAt == request.time;
    }
    match /applications/{id} {
      allow create: if ownId(id)
        && request.auth.token.firebase.sign_in_provider == 'anonymous'
        && get(/databases/$(database)/documents/settings/registration).data.enabled == true
        && valid(request.resource.data, id);
      allow get: if admin() || ownId(id);
      allow list: if admin() && request.query.limit <= 100;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['new','reviewing','accepted','rejected']
        && request.resource.data.updatedAt == request.time;
      // Deletion is restricted to trusted project owners using the Firebase console.
      allow delete: if false;
    }
    // ARVUS member portal: separate collections; recruitment permissions above are unchanged.
    function pGoogle() {
      return request.auth != null && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function pEmail() {
      let address = request.auth.token.email;
      return exists(/databases/$(database)/documents/portalLogins/$(address))
        ? get(/databases/$(database)/documents/portalLogins/$(address)).data.memberId : address;
    }
    function pOwner() {
      return pGoogle() && request.auth.token.email in ['rmzazakli@gmail.com','remziazakli@gmail.com'];
    }
    function pGrant() { return get(/databases/$(database)/documents/portalAccess/$(pEmail())).data; }
    function pValidLogin(a,id) { return a.active == true && a.get('loginEmail',id) == request.auth.token.email; }
    function pMemberActive() {
      let id = pEmail();
      return pValidLogin(get(/databases/$(database)/documents/portalAccess/$(id)).data,id);
    }
    function pMemberAdmin() {
      let id = pEmail();
      let a = get(/databases/$(database)/documents/portalAccess/$(id)).data;
      return pValidLogin(a,id) && a.role == 'admin';
    }
    function pMemberTeam(team,mentorOnly) {
      let id = pEmail();
      let a = get(/databases/$(database)/documents/portalAccess/$(id)).data;
      return pValidLogin(a,id) && ((!mentorOnly && a.role == 'admin') || (a.role == 'mentor' && team in a.teamIds));
    }
    function pMemberRecord(member,team) {
      let id = pEmail();
      let a = get(/databases/$(database)/documents/portalAccess/$(id)).data;
      return pValidLogin(a,id) && (a.role == 'admin' || member == id || (a.role == 'mentor' && team in a.teamIds));
    }
    function pActive() { return pGoogle() && (pOwner() || pMemberActive()); }
    function pAdmin() { return pGoogle() && (pOwner() || pMemberAdmin()); }
    function pLead(team) { return pGoogle() && pMemberTeam(team,true); }
    function pManage(team) { return pGoogle() && (pOwner() || pMemberTeam(team,false)); }
    function pTask(d) { return pGoogle() && (pOwner() || pMemberRecord(d.assignee,d.teamId)); }
    function pEnrollment(d) { return pGoogle() && (pOwner() || pMemberRecord(d.memberEmail,d.teamId)); }
    function pList() { return request.query.limit != null && request.query.limit <= 2000; }
    function pMail(v) { return text(v,3,254) && v.matches('^[^/@\\s]+@[^/@\\s]+[.][^/@\\s]+$') && v == v.lower(); }
    function pDate(v) { return v is string && (v == '' || v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function pLink(v) { return text(v,0,1000) && (v == '' || v.matches('^https?://[^\\s]+$')); }
    function pAssigned(email, team) {
      let a = get(/databases/$(database)/documents/portalAccess/$(email)).data;
      return a.active == true && (team in a.teamIds || a.role == 'admin');
    }
    function pDeletionValid(d,id) {
      let old = resource == null ? {} : resource.data;
      let deleted = d.get('deleted',false);
      let sameAudit = d.get('deletedAt',null) == old.get('deletedAt',null) && d.get('deletedBy','') == old.get('deletedBy','');
      return deleted is bool
        && ((!deleted && !old.get('deleted',false)) || deleted == getAfter(/databases/$(database)/documents/portalMembers/$(id)).data.get('deleted',false))
        && (!deleted || d.active == false)
        && (deleted == old.get('deleted',false) ? sameAudit
          : (id != pEmail() && !(id in ['rmzazakli@gmail.com','remziazakli@gmail.com']) && d.active == false
            && (deleted ? d.deletedAt == request.time && d.deletedBy == pEmail() : sameAudit)));
    }
    function pAccessValid(d,email) {
      return d.keys().hasOnly(['name','role','teamIds','active','updatedAt','loginEmail','deleted','deletedAt','deletedBy'])
        && pMail(email) && text(d.name,2,160) && d.role in ['admin','mentor','member']
        && d.teamIds is list && d.teamIds.size() <= 10 && d.active is bool
        && pMail(d.get('loginEmail',email))
        && (d.get('loginEmail',email) == email || getAfter(/databases/$(database)/documents/portalLogins/$(d.loginEmail)).data.memberId == email)
        && d.updatedAt == request.time && pDeletionValid(d,email);
    }
    match /portalAccess/{email} {
      allow get: if pGoogle() && (email == pEmail() || pAdmin());
      allow list: if pAdmin() && pList();
      allow create, update: if pAdmin() && pAccessValid(request.resource.data,email)
        && (!(email in ['rmzazakli@gmail.com','remziazakli@gmail.com'])
          || (request.resource.data.active == true && request.resource.data.role == 'admin' && request.resource.data.get('loginEmail',email) == email));
      allow delete: if false;
    }
    match /portalMembers/{email} {
      allow get, list: if pActive() && (pAdmin() || email == pEmail()
        || (pGrant().role == 'mentor' && resource.data.teamIds.hasAny(pGrant().teamIds)));
      allow create, update: if pAdmin()
        && request.resource.data.keys().hasOnly(['name','email','phone','university','department','year','jobTitle','notes','teamIds','updatedAt','loginEmail','deleted'])
        && request.resource.data.get('deleted',false) is bool
        && request.resource.data.get('deleted',false) == getAfter(/databases/$(database)/documents/portalAccess/$(email)).data.get('deleted',false)
        && request.resource.data.email == email && pMail(email)
        && request.resource.data.get('loginEmail',email) == getAfter(/databases/$(database)/documents/portalAccess/$(email)).data.get('loginEmail',email)
        && text(request.resource.data.name,2,160) && text(request.resource.data.phone,0,40)
        && text(request.resource.data.university,0,160) && text(request.resource.data.department,0,160)
        && text(request.resource.data.year,0,80) && text(request.resource.data.jobTitle,0,160)
        && text(request.resource.data.notes,0,3000) && request.resource.data.teamIds is list
        && request.resource.data.teamIds == getAfter(/databases/$(database)/documents/portalAccess/$(email)).data.teamIds
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /portalLogins/{address} {
      allow get: if pGoogle() && (address == request.auth.token.email || pAdmin());
      allow list: if pAdmin() && pList();
      allow create, update: if pAdmin() && pMail(address)
        && !(address in ['rmzazakli@gmail.com','remziazakli@gmail.com'])
        && request.resource.data.keys().hasOnly(['memberId','updatedAt'])
        && pMail(request.resource.data.memberId)
        && !(request.resource.data.memberId in ['rmzazakli@gmail.com','remziazakli@gmail.com'])
        && request.resource.data.updatedAt == request.time
        && (!exists(/databases/$(database)/documents/portalAccess/$(address)) || address == request.resource.data.memberId)
        && (!exists(/databases/$(database)/documents/portalMembers/$(address)) || address == request.resource.data.memberId)
        && (resource == null || resource.data.memberId == request.resource.data.memberId)
        && getAfter(/databases/$(database)/documents/portalAccess/$(request.resource.data.memberId)).data.loginEmail == address;
      allow delete: if pAdmin()
        && getAfter(/databases/$(database)/documents/portalAccess/$(resource.data.memberId)).data.get('loginEmail',resource.data.memberId) != address;
    }
    match /portalTeams/{id} {
      allow get: if pActive();
      allow list: if pActive() && pList();
      allow create, update: if pAdmin()
        && request.resource.data.keys().hasOnly(['name','kind','description','color','updatedAt'])
        && text(request.resource.data.name,2,160) && request.resource.data.kind in ['team','unit']
        && text(request.resource.data.description,0,1000)
        && request.resource.data.color in ['blue','purple','orange','teal']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    function pTaskValid(d) {
      return d.keys().hasOnly(['title','description','teamId','assignee','due','status','blocker','evidence','evidenceUrl','createdAt','updatedAt','lastCommentId','lastCommentBy','lastCommentAt'])
        && text(d.title,2,160) && text(d.description,0,3000) && text(d.teamId,1,100)
        && pMail(d.assignee) && pDate(d.due) && d.status in ['todo','doing','done']
        && text(d.blocker,0,1000) && text(d.evidence,0,3000) && pLink(d.evidenceUrl)
        && (d.status != 'done' || d.blocker == '') && d.createdAt is timestamp
        && d.updatedAt == request.time;
    }
    match /portalTasks/{id} {
      // Creation transactions check for collisions before writing a new record.
      allow get: if resource == null ? pActive() : pTask(resource.data);
      allow list: if pList() && pTask(resource.data);
      allow create: if pManage(request.resource.data.teamId) && pTaskValid(request.resource.data)
        && pAssigned(request.resource.data.assignee,request.resource.data.teamId)
        && request.resource.data.createdAt == request.time && request.resource.data.lastCommentId == ''
        && request.resource.data.lastCommentBy == '' && request.resource.data.lastCommentAt == null;
      allow update: if pTask(resource.data) && (
        (pTaskValid(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','teamId','assignee','due','status','blocker','evidence','evidenceUrl','updatedAt'])
          && ((pManage(resource.data.teamId) && pManage(request.resource.data.teamId)
            && pAssigned(request.resource.data.assignee,request.resource.data.teamId))
            || (resource.data.assignee == pEmail()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','blocker','evidence','evidenceUrl','updatedAt']))))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCommentId','lastCommentBy','lastCommentAt'])
          && request.resource.data.lastCommentBy == pEmail() && request.resource.data.lastCommentAt == request.time
          && getAfter(/databases/$(database)/documents/portalTasks/$(id)/comments/$(request.resource.data.lastCommentId)).data.author == pEmail()
          && getAfter(/databases/$(database)/documents/portalTasks/$(id)/comments/$(request.resource.data.lastCommentId)).data.createdAt == request.time));
      allow delete: if false;
      match /comments/{cid} {
        function task() { return get(/databases/$(database)/documents/portalTasks/$(id)).data; }
        allow get: if pTask(task());
        allow list: if pList() && pTask(task());
        allow create: if pTask(task())
          && request.resource.data.keys().hasOnly(['author','body','createdAt'])
          && request.resource.data.author == pEmail() && text(request.resource.data.body,1,2000)
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/portalTasks/$(id)).data.lastCommentId == cid;
        allow update, delete: if false;
      }
    }
    match /portalRoutes/{id} {
      allow get: if pActive();
      allow list: if pActive() && pList();
      allow create, update: if pManage(request.resource.data.teamId)
        && (resource == null || pManage(resource.data.teamId))
        && request.resource.data.keys().hasOnly(['name','description','teamId','steps','updatedAt'])
        && text(request.resource.data.name,2,160) && text(request.resource.data.description,0,1000)
        && request.resource.data.steps is list && request.resource.data.steps.size() >= 1 && request.resource.data.steps.size() <= 15
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /portalEnrollments/{id} {
      allow get: if resource == null ? pActive() : pEnrollment(resource.data);
      allow list: if pList() && pEnrollment(resource.data);
      allow create: if pManage(request.resource.data.teamId)
        && request.resource.data.keys().hasOnly(['name','routeId','teamId','memberEmail','mentorEmail','due','stepCount','createdAt'])
        && text(request.resource.data.name,2,160) && text(request.resource.data.routeId,1,100)
        && pAssigned(request.resource.data.memberEmail,request.resource.data.teamId)
        && pAssigned(request.resource.data.mentorEmail,request.resource.data.teamId)
        && get(/databases/$(database)/documents/portalAccess/$(request.resource.data.mentorEmail)).data.role in ['mentor','admin']
        && request.resource.data.memberEmail != request.resource.data.mentorEmail
        && pDate(request.resource.data.due) && request.resource.data.due != ''
        && request.resource.data.stepCount is int && request.resource.data.stepCount >= 1 && request.resource.data.stepCount <= 15
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /steps/{sid} {
        function enrollment() { return get(/databases/$(database)/documents/portalEnrollments/$(id)).data; }
        function afterEnrollment() { return getAfter(/databases/$(database)/documents/portalEnrollments/$(id)).data; }
        allow get: if pEnrollment(enrollment());
        allow list: if pList() && pEnrollment(enrollment());
        allow create: if pManage(afterEnrollment().teamId)
          && afterEnrollment().createdAt == request.time
          && request.resource.data.keys().hasOnly(['index','title','status','evidence','evidenceUrl','feedback','reviewerEmail','reviewedAt','updatedAt'])
          && request.resource.data.index is int && request.resource.data.index >= 0 && request.resource.data.index < afterEnrollment().stepCount
          && text(request.resource.data.title,1,300) && request.resource.data.status == 'todo'
          && request.resource.data.evidence == '' && request.resource.data.evidenceUrl == ''
          && request.resource.data.feedback == '' && request.resource.data.reviewerEmail == ''
          && request.resource.data.reviewedAt == null && request.resource.data.updatedAt == request.time;
        allow update: if pActive() && (
          (enrollment().memberEmail == pEmail() && resource.data.status != 'done'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['evidence','evidenceUrl','status','updatedAt'])
            && text(request.resource.data.evidence,5,3000) && pLink(request.resource.data.evidenceUrl)
            && request.resource.data.status == 'pending' && request.resource.data.updatedAt == request.time)
          || ((pAdmin() || (enrollment().mentorEmail == pEmail() && pLead(enrollment().teamId))) && enrollment().memberEmail != pEmail()
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','feedback','reviewerEmail','reviewedAt','updatedAt'])
            && request.resource.data.status in ['todo','done'] && text(request.resource.data.feedback,0,2000)
            && (request.resource.data.status == 'done' || request.resource.data.feedback.size() > 0)
            && request.resource.data.reviewerEmail == pEmail() && request.resource.data.reviewedAt == request.time
            && request.resource.data.updatedAt == request.time));
        allow delete: if false;
      }
    }
    function pAsset(d) {
      return d.keys().hasOnly(['name','code','location','condition','note','activeLoanId','updatedAt'])
        && text(d.name,2,160) && text(d.code,1,100) && text(d.location,0,160)
        && d.condition in ['ready','maintenance'] && text(d.note,0,1000)
        && text(d.activeLoanId,0,100) && d.updatedAt == request.time;
    }
    match /portalEquipment/{id} {
      allow get: if pActive();
      allow list: if pActive() && pList();
      allow create: if pAdmin() && pAsset(request.resource.data) && request.resource.data.code == id && request.resource.data.activeLoanId == '';
      allow update: if pAdmin() && pAsset(request.resource.data) && request.resource.data.code == id && (
        request.resource.data.activeLoanId == resource.data.activeLoanId
        || (resource.data.activeLoanId == '' && resource.data.condition == 'ready' && request.resource.data.condition == 'ready'
          && getAfter(/databases/$(database)/documents/portalLoans/$(request.resource.data.activeLoanId)).data.equipmentId == id
          && getAfter(/databases/$(database)/documents/portalLoans/$(request.resource.data.activeLoanId)).data.returnedAt == null)
        || (request.resource.data.activeLoanId == '' && resource.data.activeLoanId != ''
          && getAfter(/databases/$(database)/documents/portalLoans/$(resource.data.activeLoanId)).data.returnedAt == request.time));
      allow delete: if false;
    }
    match /portalLoans/{id} {
      allow get: if pActive() && (pAdmin() || resource.data.memberEmail == pEmail());
      allow list: if pList() && pActive() && (pAdmin() || resource.data.memberEmail == pEmail());
      allow create: if pAdmin()
        && request.resource.data.keys().hasOnly(['equipmentId','equipmentName','memberEmail','memberName','due','purpose','issuedAt','returnRequested','returnedAt','returnNote','returnCondition'])
        && text(request.resource.data.equipmentId,1,100) && text(request.resource.data.equipmentName,2,160)
        && pMail(request.resource.data.memberEmail) && text(request.resource.data.memberName,2,160)
        && get(/databases/$(database)/documents/portalAccess/$(request.resource.data.memberEmail)).data.active == true
        && pDate(request.resource.data.due) && request.resource.data.due != ''
        && text(request.resource.data.purpose,1,1000) && request.resource.data.issuedAt == request.time
        && request.resource.data.returnRequested == false && request.resource.data.returnedAt == null
        && request.resource.data.returnNote == '' && request.resource.data.returnCondition == ''
        && get(/databases/$(database)/documents/portalEquipment/$(request.resource.data.equipmentId)).data.activeLoanId == ''
        && get(/databases/$(database)/documents/portalEquipment/$(request.resource.data.equipmentId)).data.condition == 'ready'
        && getAfter(/databases/$(database)/documents/portalEquipment/$(request.resource.data.equipmentId)).data.activeLoanId == id;
      allow update: if pActive() && resource.data.returnedAt == null && (
        (resource.data.memberEmail == pEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnRequested'])
          && request.resource.data.returnRequested == true)
        || (pAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['returnedAt','returnNote','returnCondition'])
          && request.resource.data.returnedAt == request.time && text(request.resource.data.returnNote,0,1000)
          && request.resource.data.returnCondition in ['ready','maintenance']
          && (request.resource.data.returnCondition != 'maintenance' || request.resource.data.returnNote.size() > 0)
          && getAfter(/databases/$(database)/documents/portalEquipment/$(resource.data.equipmentId)).data.activeLoanId == ''
          && getAfter(/databases/$(database)/documents/portalEquipment/$(resource.data.equipmentId)).data.condition == request.resource.data.returnCondition));
      allow delete: if false;
    }
    function pFinance(d) {
      return d.keys().hasOnly(['kind','amountCents','currency','date','account','category','teamId','counterparty','description','receiptUrl','createdBy','createdAt','voidedAt','voidedBy','voidReason'])
        && d.kind in ['income','expense'] && d.amountCents is int
        && d.amountCents >= 1 && d.amountCents <= 1000000000 && d.currency == 'TRY'
        && d.date is string && d.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && d.account in ['bank','cash']
        && ((d.kind == 'income' && d.category in ['sponsor','dues','donation','opening','other'])
          || (d.kind == 'expense' && d.category in ['materials','travel','event','other']))
        && text(d.teamId,0,100) && (d.teamId == '' || exists(/databases/$(database)/documents/portalTeams/$(d.teamId)))
        && text(d.counterparty,2,160) && text(d.description,2,1000) && pLink(d.receiptUrl)
        && d.createdBy == pEmail() && d.createdAt == request.time
        && d.voidedAt == null && d.voidedBy == '' && d.voidReason == '';
    }
    match /portalFinance/{id} {
      allow get: if pAdmin();
      allow list: if pAdmin() && pList();
      allow create: if pAdmin() && pFinance(request.resource.data);
      // Financial details are immutable. Corrections leave an attributed void record.
      allow update: if pAdmin() && resource.data.voidedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voidedAt','voidedBy','voidReason'])
        && request.resource.data.voidedAt == request.time
        && request.resource.data.voidedBy == pEmail() && text(request.resource.data.voidReason,5,500);
      allow delete: if false;
    }
    match /portalSeen/{email}/items/{id} {
      allow get, list: if pActive() && email == pEmail();
      allow create, update: if pActive() && email == pEmail()
        && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
